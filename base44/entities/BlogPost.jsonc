{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the blog post"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "excerpt": {
      "type": "string",
      "description": "Short preview text"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content in markdown"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional photo URLs"
    },
    "location": {
      "type": "string",
      "description": "Travel destination"
    },
    "coordinates": {
      "type": "string",
      "description": "Latitude/longitude display text"
    },
    "date_traveled": {
      "type": "string",
      "format": "date",
      "description": "When the trip occurred"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization"
    }
  },
  "required": [
    "title",
    "slug"
  ]
}